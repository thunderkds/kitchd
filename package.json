{
  "name": "kitchenos",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "pnpm --filter @kitchenos/web run dev",
    "dev:api": "pnpm --filter @kitchenos/api run start:dev",
    "dev:mobile": "pnpm --filter @kitchenos/mobile run start",
    "build": "pnpm --filter @kitchenos/shared run build && pnpm --filter @kitchenos/api run build && pnpm --filter @kitchenos/web run build",
    "test:api": "pnpm --filter @kitchenos/api run test"
  },
  "packageManager": "pnpm@10.12.4"
}
