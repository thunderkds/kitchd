generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  CHEF
  STAFF
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

enum StockMovementType {
  RECEIVE
  CONSUME
  WASTE
  ADJUST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum GuidelineType {
  SOP
  CHECKLIST
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kitchens Kitchen[]
  users    User[]
  invites  Invite[]

  @@map("organizations")
}

model Kitchen {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  invites      Invite[]
  ingredients  Ingredient[]
  recipes      Recipe[]
  tasks        Task[]
  guidelines   Guideline[]
  notes        Note[]

  @@index([organizationId])
  @@map("kitchens")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  kitchenId      String   @map("kitchen_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  role           Role     @default(OWNER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitchen      Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  invitesSent  Invite[]
  stockMovements StockMovement[]
  assignedTasks  Task[]
  notes          Note[]

  @@index([organizationId])
  @@index([kitchenId])
  @@map("users")
}

model Invite {
  id             String       @id @default(uuid())
  email          String
  organizationId String       @map("organization_id")
  kitchenId      String       @map("kitchen_id")
  role           Role
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedById    String       @map("invited_by_id")
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitchen      Kitchen      @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, kitchenId, status])
  @@index([kitchenId])
  @@map("invites")
}

model Ingredient {
  id            String   @id @default(uuid())
  kitchenId     String   @map("kitchen_id")
  name          String
  unit          String
  costPerUnit   Float    @map("cost_per_unit")
  category      String?
  allergens     String[]
  supplierId    String?  @map("supplier_id")
  minThreshold  Float?   @map("min_threshold")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  kitchen        Kitchen         @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  recipeIngredients RecipeIngredient[]

  @@index([kitchenId])
  @@map("ingredients")
}

model Recipe {
  id        String   @id @default(uuid())
  kitchenId String   @map("kitchen_id")
  name      String
  steps     String[]
  servings  Int?
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kitchen     Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  versions    RecipeVersion[]

  @@index([kitchenId])
  @@map("recipes")
}

// Current, live ingredients list for a Recipe. qty is the only field
// stored here — cost is never persisted on this row; it's always
// recomputed from the live Ingredient.cost_per_unit at read/save time
// (see RecipesService#computeCost). This is a deliberate MVP choice,
// not an oversight: cost_computed always reflects current ingredient
// pricing rather than a point-in-time snapshot.
model RecipeIngredient {
  id           String   @id @default(uuid())
  recipeId     String   @map("recipe_id")
  ingredientId String   @map("ingredient_id")
  qty          Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  // Restrict (not Cascade/SetNull): an Ingredient referenced by a Recipe
  // cannot be deleted out from under it. There is currently no
  // ingredient-delete endpoint in the Inventory module (T004), so this
  // is a forward-looking safe default rather than an active guard today.
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// Append-only version history, mirroring the StockMovement ledger
// pattern: no update/delete route, one row written per edit. Each row
// is a full snapshot of the Recipe + its ingredients qty at the moment
// of that edit, so prior versions remain retrievable after later edits.
// costComputedAtSnapshot is a historical record of what the cost WAS at
// save time for this version — distinct from the live cost_computed
// shown on GET /recipes/:id, which always reflects current prices.
model RecipeVersion {
  id                     String   @id @default(uuid())
  recipeId               String   @map("recipe_id")
  version                Int
  name                   String
  steps                  String[]
  servings               Int?
  ingredientsSnapshot    Json     @map("ingredients_snapshot")
  costComputedAtSnapshot Float    @map("cost_computed_at_snapshot")
  createdAt              DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_versions")
}

// Task CRUD only (T008). recurrenceRule and sourceRecipeId are schema
// placeholders for future tasks (T010 recurrence materialization, T009
// generate-from-recipe) — no logic reads/acts on them yet.
// checklistItems is a JSON array of {id, text, done} — toggled via
// PATCH by the assignee; no separate "complete task" endpoint here
// (that belongs to T011, which also triggers stock deduction).
model Task {
  id             String     @id @default(uuid())
  kitchenId      String     @map("kitchen_id")
  title          String
  status         TaskStatus @default(TODO)
  assigneeId     String?    @map("assignee_id")
  dueAt          DateTime?  @map("due_at")
  recurrenceRule String?    @map("recurrence_rule")
  sourceRecipeId    String? @map("source_recipe_id")
  sourceGuidelineId String? @map("source_guideline_id")
  checklistItems Json       @default("[]") @map("checklist_items")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  kitchen  Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([kitchenId])
  @@index([assigneeId])
  @@map("tasks")
}

// Non-recipe SOP/checklist documents (e.g. "Opening Checklist",
// "Sanitation Procedure"). Deliberately simpler than Recipe: no
// ingredients, no cost roll-up, no version history — just an ordered
// steps array and a type. attachments is a plain string array of
// URLs/paths; no file-storage backend is wired yet in this milestone
// (S3 not wired — stub for MVP per Edge Case Checklist).
model Guideline {
  id          String        @id @default(uuid())
  kitchenId   String        @map("kitchen_id")
  title       String
  type        GuidelineType
  steps       String[]
  attachments String[]      @default([])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  kitchen Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@index([kitchenId])
  @@map("guidelines")
}

// Freeform quick notes (T012). tags is a plain string array — tag search
// uses Prisma's `has` filter (fully parameterized, no ILIKE/tsvector
// needed for exact-tag lookup per the Approach note). linkedEntityType/Id
// mirror the Task.sourceRecipeId/sourceGuidelineId pattern: a plain
// nullable pair with NO FK constraint — informational back-reference
// only, so a Note survives (and is still loadable) after its linked
// Recipe/Task/Ingredient is deleted. linkedEntityType is validated
// against a known enum of entity kinds at the DTO layer, not by the DB.
model Note {
  id                String   @id @default(uuid())
  kitchenId         String   @map("kitchen_id")
  authorId          String   @map("author_id")
  title             String?
  body              String
  tags              String[] @default([])
  pinned            Boolean  @default(false)
  linkedEntityType  String?  @map("linked_entity_type")
  linkedEntityId    String?  @map("linked_entity_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  kitchen Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([kitchenId])
  @@index([authorId])
  @@map("notes")
}

model StockBatch {
  id           String    @id @default(uuid())
  ingredientId String    @map("ingredient_id")
  kitchenId    String    @map("kitchen_id")
  qty          Float
  expiryDate   DateTime? @map("expiry_date")
  location     String?
  createdAt    DateTime  @default(now()) @map("created_at")

  ingredient     Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([ingredientId])
  @@index([kitchenId])
  @@map("stock_batches")
}

model StockMovement {
  id           String            @id @default(uuid())
  ingredientId String            @map("ingredient_id")
  kitchenId    String            @map("kitchen_id")
  batchId      String?           @map("batch_id")
  type         StockMovementType
  qty          Float
  reason       String?
  actorId      String            @map("actor_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  ingredient Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  batch      StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([kitchenId])
  @@map("stock_movements")
}
